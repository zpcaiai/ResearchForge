{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "title": "IdeaCandidate",
 "type": "object",
 "required": [
  "idea_id",
  "title",
  "mode",
  "hypothesis",
  "delta",
  "minimum_experiment",
  "success_metrics",
  "kill_criteria"
 ],
 "properties": {
  "idea_id": {
   "type": "string",
   "pattern": "^I-[0-9]{3,}$"
  },
  "title": {
   "type": "string",
   "minLength": 8
  },
  "mode": {
   "enum": [
    "extend_generalize",
    "replace_simplify",
    "combine_transfer",
    "explain_diagnose",
    "benchmark_evaluate",
    "systemize"
   ],
   "description": "Must be one of comparison_mode.admissible_idea_modes. Enforced here so an inadmissible direction cannot be written at all, not merely filtered later."
  },
  "hypothesis": {
   "type": "string",
   "minLength": 12
  },
  "delta": {
   "type": "string",
   "minLength": 8,
   "description": "The exact difference from the baseline. 'Improve X' is not a delta."
  },
  "mechanism": {
   "type": "string"
  },
  "why_it_should_work": {
   "type": "string"
  },
  "closest_prior_work": {
   "type": [
    "string",
    "null"
   ]
  },
  "minimum_experiment": {
   "type": "object",
   "required": [
    "description",
    "baseline",
    "metric"
   ],
   "properties": {
    "description": {
     "type": "string"
    },
    "baseline": {
     "type": "string"
    },
    "dataset": {
     "type": [
      "string",
      "null"
     ]
    },
    "metric": {
     "type": "string"
    },
    "expected_effect": {
     "type": [
      "string",
      "null"
     ]
    },
    "compute_estimate": {
     "type": [
      "string",
      "null"
     ]
    },
    "duration_estimate": {
     "type": [
      "string",
      "null"
     ]
    }
   }
  },
  "success_metrics": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string"
   }
  },
  "kill_criteria": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "string"
   },
   "description": "What result would end this direction. A candidate without one cannot fail, and a direction that cannot fail is not research."
  },
  "compute_cost": {
   "type": [
    "string",
    "null"
   ]
  },
  "novelty_risk": {
   "type": [
    "string",
    "null"
   ]
  },
  "novelty_status": {
   "type": "string"
  },
  "feasibility": {
   "type": "object"
  },
  "_synthetic": {
   "type": "boolean"
  }
 },
 "additionalProperties": true
}